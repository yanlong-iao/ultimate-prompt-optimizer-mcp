# ─────────────────────────────────────────────────────────────
# LLM (OpenAI-compatible) — used by every tool
# DeepSeek: https://api.deepseek.com + deepseek-flash (cheap) / deepseek-v4-pro (stronger)
# ─────────────────────────────────────────────────────────────
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_MS=120000

# Optional: model under test / judge (default: same as LLM_*)
# EVAL_MODEL=deepseek-flash
# JUDGE_MODEL=deepseek-v4-pro

# Optional: USD per 1M tokens, only for cost estimates in reports (check your provider's current pricing)
# LLM_PRICE_INPUT_PER_M=0.30
# LLM_PRICE_OUTPUT_PER_M=1.20

# ─────────────────────────────────────────────────────────────
# Safety & storage
# ─────────────────────────────────────────────────────────────
UPO_MAX_CALLS=80          # hard cap on API calls per tool run
UPO_CONCURRENCY=4
UPO_CACHE=true            # identical requests are answered from disk for free
# UPO_DATA_DIR=.          # where history/, reports/, .cache/ live (default: this folder)
# UPO_TEMPLATES_DIR=custom-templates

# ─────────────────────────────────────────────────────────────
# Optional: a self-hosted linshenkx/prompt-optimizer (Docker) as the optimize backend
# Leave PO_BASE_URL empty to use the built-in template library (recommended).
# ─────────────────────────────────────────────────────────────
PO_BASE_URL=
PO_BACKEND=local          # local | auto | remote
PO_ACCESS_PASSWORD=
PO_ACCESS_USERNAME=admin
PO_AUTH_MODE=auto
PO_TIMEOUT_MS=180000

LOG_LEVEL=info
